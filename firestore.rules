rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Authoritative Admin check: Custom claims, recognized admin email/UID, or verified admins registry document
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email == 'praveenkumarpillai2010@gmail.com') ||
        request.auth.uid == 'IcZE8EtOoUVWSWE8WQcyNpN72hz1' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------------------
    // 1. Websites Catalog: Public read, Admin-only modification
    // -------------------------------------------------------------------------
    match /websites/{websiteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. Orders Collection: Customer data isolation, Admin-only status changes
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      // Admin can read all orders; Customers can only read their own orders
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.customerUid == request.auth.uid ||
          (resource.data.customerEmail != null && resource.data.customerEmail == request.auth.token.email)
        )
      );
      // Public/customer order placement during checkout
      allow create: if true;
      // Only administrators can modify order status, payment status, or delete orders
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. Customers Collection: Isolated to authenticated user or admin
    // -------------------------------------------------------------------------
    match /customers/{customerId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == customerId);
    }

    // -------------------------------------------------------------------------
    // 4. Agency Settings: Public read, Admin-only modification
    // -------------------------------------------------------------------------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 5. Administrators Registry: Admin-only management
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'praveenkumarpillai2010@gmail.com') ||
        request.auth.uid == 'IcZE8EtOoUVWSWE8WQcyNpN72hz1'
      ));
    }

    // -------------------------------------------------------------------------
    // 6. Audit Trail Logs: Admin-only access
    // -------------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 7. Call Bookings: Customer isolated or Admin
    // -------------------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.customerUid == request.auth.uid ||
          (resource.data.customerEmail != null && resource.data.customerEmail == request.auth.token.email)
        )
      );
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 8. Messages: Customer isolated or Admin
    // -------------------------------------------------------------------------
    match /messages/{messageId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.customerUid == request.auth.uid ||
          (resource.data.customerEmail != null && resource.data.customerEmail == request.auth.token.email)
        )
      );
      allow create: if isAdmin() || (
        isSignedIn() && (
          request.resource.data.customerUid == request.auth.uid ||
          (request.resource.data.customerEmail != null && request.resource.data.customerEmail == request.auth.token.email)
        )
      );
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Catch-all Default Deny
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

