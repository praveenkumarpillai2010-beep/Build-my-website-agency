{
  "entities": {
    "website": {
      "title": "Website",
      "description": "Real website published by the agency in the catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique website ID" },
        "name": { "type": "string", "description": "Name of the website" },
        "category": { "type": "string", "description": "Industry category" },
        "shortDescription": { "type": "string", "description": "Concise summary for catalog cards" },
        "description": { "type": "string", "description": "Comprehensive website description and deliverables" },
        "price": { "type": "number", "description": "Selling price" },
        "currency": { "type": "string", "description": "Currency code (e.g. USD)" },
        "demoUrl": { "type": "string", "description": "Preview / Demo URL" },
        "liveUrl": { "type": "string", "description": "Exact live website URL" },
        "imageUrl": { "type": "string", "description": "Website thumbnail/preview image URL" },
        "thumbnailUrl": { "type": "string", "description": "Thumbnail preview image URL" },
        "features": { "type": "array", "description": "List of key features" },
        "technologies": { "type": "array", "description": "List of technologies/frameworks used" },
        "status": { "type": "string", "description": "Availability status (available, reserved, sold, in_development)" },
        "featured": { "type": "boolean", "description": "Featured on homepage flag" },
        "published": { "type": "boolean", "description": "Publicly visible flag" },
        "displayOrder": { "type": "number", "description": "Sort display order" },
        "createdAt": { "type": "string", "description": "Creation timestamp ISO" },
        "updatedAt": { "type": "string", "description": "Last update timestamp ISO" }
      },
      "required": ["name", "category", "price", "currency", "liveUrl", "createdAt", "updatedAt"]
    },
    "order": {
      "title": "Order",
      "description": "Customer purchase order for a website",
      "type": "object",
      "properties": {
        "order_id": { "type": "string", "description": "Order identifier" },
        "customer_id": { "type": "string", "description": "Customer identifier" },
        "customer_name": { "type": "string", "description": "Customer name" },
        "customer_email": { "type": "string", "description": "Customer email" },
        "customer_phone": { "type": "string", "description": "Customer phone" },
        "website_id": { "type": "string", "description": "ID of website" },
        "website_name": { "type": "string", "description": "Name of website" },
        "amount": { "type": "number", "description": "Amount in USD" },
        "currency": { "type": "string", "description": "Currency" },
        "payment_status": { "type": "string", "description": "Payment status" },
        "project_status": { "type": "string", "description": "Project status" },
        "preview_url": { "type": "string", "description": "Preview URL" },
        "final_url": { "type": "string", "description": "Final live URL" },
        "created_at": { "type": "string", "description": "Created at timestamp" }
      },
      "required": ["order_id", "customer_name", "customer_email", "website_name", "amount", "payment_status", "project_status", "created_at"]
    },
    "customer": {
      "title": "Customer",
      "description": "Registered customer profile",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Customer email" },
        "name": { "type": "string", "description": "Customer name" },
        "phone": { "type": "string", "description": "Customer phone" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["email", "name", "createdAt"]
    },
    "setting": {
      "title": "Setting",
      "description": "Agency settings and contact configuration",
      "type": "object",
      "properties": {
        "agencyName": { "type": "string", "description": "Agency business name" },
        "whatsappNumber": { "type": "string", "description": "WhatsApp number" },
        "displayPhone": { "type": "string", "description": "Display phone number" },
        "email": { "type": "string", "description": "Contact email" },
        "showStats": { "type": "boolean", "description": "Display stats toggle" },
        "stripeEnabled": { "type": "boolean", "description": "Stripe enabled flag" }
      },
      "required": ["agencyName", "whatsappNumber", "email"]
    },
    "admin": {
      "title": "Admin",
      "description": "Authorized administrator user profile and claims registry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase user UID" },
        "email": { "type": "string", "description": "Admin email address" },
        "admin": { "type": "boolean", "description": "Admin role claim status" },
        "assignedAt": { "type": "string", "description": "Role assignment timestamp" },
        "assignedBy": { "type": "string", "description": "Assigner UID or system bootstrap" }
      },
      "required": ["uid", "email", "admin", "assignedAt"]
    },
    "audit_log": {
      "title": "AuditLog",
      "description": "Audit trail log of sensitive administrative actions",
      "type": "object",
      "properties": {
        "adminUid": { "type": "string", "description": "Administrator UID performing the action" },
        "adminEmail": { "type": "string", "description": "Administrator email" },
        "action": { "type": "string", "description": "Action performed (e.g. WEBSITE_CREATED, ORDER_STATUS_CHANGED)" },
        "resourceType": { "type": "string", "description": "Target resource type" },
        "resourceId": { "type": "string", "description": "Target resource identifier" },
        "timestamp": { "type": "string", "description": "ISO timestamp of the event" },
        "details": { "type": "object", "description": "Additional context metadata" }
      },
      "required": ["adminUid", "action", "resourceType", "resourceId", "timestamp"]
    }
  },
  "firestore": {
    "/websites/{websiteId}": {
      "schema": "website",
      "description": "Collection of published real agency websites"
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Collection of customer purchase orders"
    },
    "/customers/{customerId}": {
      "schema": "customer",
      "description": "Collection of customers"
    },
    "/settings/{settingId}": {
      "schema": "setting",
      "description": "Agency configuration document"
    },
    "/admins/{adminId}": {
      "schema": "admin",
      "description": "Registry of authorized administrators"
    },
    "/audit_logs/{logId}": {
      "schema": "audit_log",
      "description": "Audit log entries for administrative operations"
    }
  }
}
